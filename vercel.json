{
  "framework": null,
  "buildCommand": "npm test",
  "outputDirectory": "public",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/leadflow.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/leadflow?action=cron",
      "schedule": "0 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    }
  ]
}